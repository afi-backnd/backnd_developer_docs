{
  "schema_version": "1.0",
  "provider": "TheBackend",
  "description": "AI agent가 TheBackend 개발자 문서를 탐색하고 활용하기 위한 스킬 정의",
  "docs_url": "https://docs.thebackend.io",
  "repo_url": "https://github.com/afi-backnd/backnd_developer_docs",
  "skills": [
    {
      "name": "search_docs",
      "description": "키워드로 관련 TheBackend 문서 경로와 설명을 찾습니다",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "검색 키워드 (한국어/영어 모두 가능)"
          },
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat", "api"],
            "description": "특정 모듈로 검색 범위 제한 (선택)"
          },
          "limit": {
            "type": "integer",
            "default": 5,
            "description": "반환할 최대 결과 수"
          }
        },
        "required": ["query"]
      },
      "reference": "skills/search_docs.md"
    },
    {
      "name": "get_sdk_info",
      "description": "특정 SDK 모듈의 개요, 주요 기능, 최신 버전, 문서 경로를 반환합니다",
      "parameters": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat", "api-chat"],
            "description": "SDK 모듈명"
          }
        },
        "required": ["module"]
      },
      "reference": "skills/get_sdk_info.md"
    },
    {
      "name": "get_code_example",
      "description": "기능명을 입력하면 관련 코드 예제와 문서 경로를 반환합니다",
      "parameters": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "description": "기능명 (예: 랭킹, 길드, 푸시, 영수증 검증)"
          },
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat"],
            "description": "SDK 모듈 한정 (선택)"
          }
        },
        "required": ["feature"]
      },
      "reference": "skills/get_code_example.md"
    },
    {
      "name": "get_error_info",
      "description": "에러 코드 또는 에러 메시지를 입력하면 원인과 해결 방법을 반환합니다",
      "parameters": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "에러 코드 또는 에러 메시지"
          },
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat"],
            "description": "SDK 모듈 한정 (선택)"
          }
        },
        "required": ["error"]
      },
      "reference": "skills/get_error_info.md"
    },
    {
      "name": "get_latest_version",
      "description": "모듈명을 입력하면 최신 버전 정보와 릴리즈 노트 경로를 반환합니다",
      "parameters": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat", "api-chat"],
            "description": "SDK 모듈명"
          }
        },
        "required": ["module"]
      },
      "reference": "skills/get_latest_version.md"
    },
    {
      "name": "get_changelog",
      "description": "모듈과 버전을 입력하면 해당 버전의 변경 이력을 반환합니다",
      "parameters": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "enum": ["backend", "chat", "function", "world", "database", "unreal-chat", "api-chat"],
            "description": "SDK 모듈명"
          },
          "version": {
            "type": "string",
            "description": "특정 버전 (미입력 시 최신 버전)"
          },
          "from_version": {
            "type": "string",
            "description": "범위 조회 시작 버전"
          },
          "to_version": {
            "type": "string",
            "description": "범위 조회 종료 버전"
          }
        },
        "required": ["module"]
      },
      "reference": "skills/get_changelog.md"
    }
  ]
}
